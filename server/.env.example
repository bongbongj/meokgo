SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/meokgo_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=meokgo
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# 개인 이미지 저장 경로 및 만료 파일 정리 주기
STORAGE_LOCAL_ROOT=./storage
STORAGE_CLEANUP_DELAY_MS=3600000
# 배포 서버에 설치된 한글 지원 글꼴을 지정한다.
STORY_FONT_FAMILY=SansSerif
# 지역 마스터 달성에 필요한 서로 다른 탐험 종료 날짜 수
RETENTION_REGION_MASTER_VISIT_DAYS=3
